; SilentSuite (Etebase) server config, templated by materia.
; No [database] password here: it comes from a second ini, the
; silentsuiteDbIni podman secret (ETEBASE_EASY_CONFIG_PATH). The server reads
; that file first and this one after, and later files win, so a `password =`
; here would silently override the vault. Never add one.
[global]
secret_file = /data/secret.txt
debug = false
media_root = /data/media
static_root = /data/static

[allowed_hosts]
allowed_host1 = silentsuite.{{ .baseDomain }}
; The container healthcheck probes localhost.
allowed_host2 = localhost

[database]
engine = django.db.backends.postgresql
name = silentsuite
user = silentsuite
host = silentsuite-postgres
port = 5432
