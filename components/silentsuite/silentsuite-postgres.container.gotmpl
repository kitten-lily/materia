[Unit]
Description=SilentSuite PostgreSQL
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=silentsuite-postgres
# Upstream's tested major (16), at the Umbrel package's pin. PG 16 keeps the
# default PGDATA /var/lib/postgresql/data, so no override (unlike 18).
# Take `mise db:backup` before changing this image; a major bump needs a
# pg_dump/pg_upgrade path (BUG-010).
Image=docker.io/library/postgres:16.16-alpine@sha256:f2f98726820d0342055351c6e9d36e705f5bfffb3dd53ff556325114b08afb6d
Network=newt-net
Environment=POSTGRES_DB=silentsuite
Environment=POSTGRES_USER=silentsuite
{{ secretEnv "silentsuiteDbPassword" "POSTGRES_PASSWORD" }}
Volume=silentsuite-db.volume:/var/lib/postgresql/data:Z
# Upstream compose settings.
ShmSize=128m
Exec=postgres -c max_connections=200
Notify=healthy
# TCP, not the socket: on a fresh volume the entrypoint's temporary init
# server listens on the socket only, so a socket probe passes before the
# real server is up (#205).
HealthCmd=pg_isready -h 127.0.0.1 -U silentsuite -d silentsuite
HealthInterval=5s
HealthRetries=20
HealthTimeout=5s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
