# Named volume for beszel hub persistent data (/beszel_data).
# henrygd/beszel builds FROM scratch and has no /etc/passwd, so the image
# ships no USER directive — but as a static Go binary it runs fine under an
# arbitrary UID via User=/Group= below (verified: issue #26). User=/Group=
# here give the volume the matching 1000:1000 ownership, same pattern as
# letsencrypt.volume for minimus traefik.
[Volume]
User=1000
Group=1000
