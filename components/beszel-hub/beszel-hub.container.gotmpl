[Unit]
Description=Beszel hub
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=beszel-hub
Image=docker.io/henrygd/beszel:0.20.0@sha256:897e807a065adf8e89e30ae0cd79d1f5e38fe84ccaffbc418bde9d3cdca4eacc
# Standalone container — NOT in pangolin.pod. The hub is isolated from the
# edge node's shared network namespace (a misbehaving hub must not be able to
# affect public ingress). Routed to the public internet via Newt tunnel
# (on flutterina: Newt + beszel-hub share the newt-net network, so Newt
# reaches the hub by container name "beszel-hub:8090" — no PublishPort needed
# for the tunnel path). The PublishPort is kept as a safety net for the
# existing local-site resource path until the dashboard is reconfigured to
# route through the tunnel instead. Once that's done, PublishPort can be
# removed.
Network=newt-net
PublishPort=8090:8090
Environment=APP_URL=https://beszel.{{ .baseDomain }}
Volume=beszel-data.volume:/beszel_data:z
# Runs as root. The UID-1000 hardening (#26) was reverted: flutterina's
# beszel-data volume predates it and is root-owned, and podman only
# auto-chowns an EMPTY named volume — so the hub crashed on every start
# with "attempt to write a readonly database (1544)". Re-attempting needs
# a host-side `podman unshare chown -R 1000:1000` on the existing volume
# FIRST. See AGENTS.md ("Switching an existing component to non-root").

# The hub binary probes itself: `beszel health` HTTP-GETs /api/health and
# exits non-zero on anything but 200. JSON-array form is MANDATORY here —
# the image is FROM scratch with no /bin/sh, and podman wraps a plain
# string in `/bin/sh -c`. The --url flag is required (bare `health` exits
# 1 with `required flag(s) "url" not set`). This is the check that would
# have caught BUG-008 on its first interval instead of after 3.5 days.
HealthCmd=["/beszel","health","--url","http://localhost:8090"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
