[Unit]
Description=Traefik
After=app.service
Requires=app.service

[Container]
Pod=pangolin.pod
ContainerName=traefik
# Docker Official Image (minimus exit: reg.mini.dev stopped serving anonymous
# pulls around 2026-10-22). Runs as root, so :80/:443 need no
# AddCapability=NET_BIND_SERVICE. It reads the UID-1000 acme.json that
# minimus left (mode 600). Verified locally with badger v1.8.0.
Image=docker.io/library/traefik:v3.7.18@sha256:af6e7de981b23d51d8d967e0e508af6a8673f29831138720ab854617fd1b1229
Exec=--configFile=/etc/traefik/traefik_config.yml
# Plugins (badger) are downloaded on every start; keep them off the
# container layer.
Tmpfs=/plugins-storage
{{ secretEnv "cfDnsApiToken" "CF_DNS_API_TOKEN" }}
Volume={{ m_dataDir "pangolin" }}/traefik:/etc/traefik:ro,z
Volume=letsencrypt.volume:/letsencrypt:z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
