api:
  dashboard: true

experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "{{ .badgerVersion }}"

log:
  level: "INFO"
  format: "common"

# Temporary (#179, Bluefin pilot Phase 4 E6): a request-rate and concurrency
# baseline. JSON to stdout, so it lands in traefik.service's journal. Every
# field is dropped except the five the analysis needs: no client IPs, paths,
# hosts or headers. Remove after the 7-day collection.
accessLog:
  format: json
  fields:
    defaultMode: drop
    names:
      StartUTC: keep
      Duration: keep
      RouterName: keep
      DownstreamStatus: keep
      RequestProtocol: keep
    headers:
      defaultMode: drop

entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: "30m"
    # QUIC on udp/443: pangolin.pod publishes 443/udp and the Hetzner
    # firewall allows it. Traefik then advertises h3 via Alt-Svc.
    http3: {}

serversTransport:
  insecureSkipVerify: true

providers:
  http:
    endpoint: "http://localhost:3001/api/v1/traefik-config"
    pollInterval: "5s"
  file:
    filename: "/etc/traefik/dynamic_config.yml"

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ .acmeEmail }}"
      storage: "/letsencrypt/acme.json"
      dnsChallenge:
        provider: cloudflare
