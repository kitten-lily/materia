[Unit]
Description=Audiobookshelf (audiobooks)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=audiobookshelf
Image=ghcr.io/advplyr/audiobookshelf:2.38.0@sha256:60064c23f32fd9099fd39e82c5132c51701d1221135bbca04cd099b589e1edc3

# Join newt-net so Newt (on bow via [Roles.tunneled]) reaches
# audiobookshelf by container name "audiobookshelf:80" for the
# audiobookshelf.<baseDomain> resource. Container name resolution only
# works on named networks, not the default bridge — same reason
# music/grimmory/newt itself use Network=newt-net.
Network=newt-net

# Audiobook library — bind mount from bow's LVM data disk
# (/var/lib/materia-data, created by bare-metal.bu's lvm-data.service).
# Read-only (:ro,z) — audiobookshelf shouldn't modify source files.
# No /books volume: ebook/comic hosting is grimmory's job on this host.
# No /podcasts volume: podcasts moved to the pinepods component (#196),
# which takes over /var/lib/materia-data/Podcasts with a private :Z label
# and UID 1000 ownership. Re-adding a mount here would fight it for the
# directory.
Volume=/var/lib/materia-data/AudioBooks:/audiobooks:ro,z

# App config (users, sessions, settings) and metadata cache (covers) —
# named volumes, not bind mounts. Materia treats the data dir as fully
# managed; app-writable runtime state needs a named volume so it isn't
# scheduled for removal as drift.
Volume=audiobookshelf-config.volume:/config:z
Volume=audiobookshelf-metadata.volume:/metadata:z

Environment=TZ=Etc/UTC

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
