[Unit]
Description=Grimmory MariaDB
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=grimmory-mariadb
# Docker Official Image (minimus exit: reg.mini.dev stopped serving anonymous
# pulls around 2026-10-22). Same version as the minimus pin. The entrypoint
# starts as root and chowns a datadir minimus left as UID 1000 to mysql
# (999) before dropping privileges; verified locally with data kept.
# Take `mise db:backup` before changing this image or the version.
Image=docker.io/library/mariadb:13.0.2@sha256:f4054da26e3a9dd6c8b5cc97363e544408b15c0fb369d7359c25dc04826eb6e1
# Join newt-net so the grimmory app reaches it by container name
# "grimmory-mariadb:3306" (DATABASE_URL in grimmory.container.gotmpl).
# Same named-network requirement as the app. No PublishPort — 3306 is
# reachable only by name on newt-net, never published to the host.
Network=newt-net
Environment=TZ=Etc/UTC
# Official MariaDB env convention: MARIADB_*, NOT the linuxserver MYSQL_*
# names upstream's compose used (silently ignored, leaving the DB
# uninitialized).
Environment=MARIADB_DATABASE=grimmory
Environment=MARIADB_USER=grimmory
{{ secretEnv "mariadbRootPassword" "MARIADB_ROOT_PASSWORD" }}
{{ secretEnv "grimmoryDbPassword" "MARIADB_PASSWORD" }}
# /var/lib/mysql is the official MariaDB data dir (NOT /config, the
# linuxserver convention upstream's compose used).
Volume=grimmory-mariadb-config.volume:/var/lib/mysql:z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
