[Unit]
Description=Logical dump of the mediamanager database
# Ordering only: a dump must never start a stopped DB. A stopped DB fails
# the dump, and the trigger reports it.
After=mediamanager-postgres.service

[Container]
ContainerName=db-dump-mediamanager
# Same pin as mediamanager-postgres.container.gotmpl, so Renovate bumps both.
Image=docker.io/library/postgres:18.7@sha256:eb63372c1e05c755f55fa30cbd07aecc443676fc6c0fa90b9002d01537841e1a
Network=newt-net
# Shared label (:z): both dump units write this volume at the same time.
Volume=db-dumps.volume:/dumps:z
Volume={{ m_dataDir "db-dump" }}/dump.bash:/db-dump.sh:ro,z
# Created by the mediamanager component; referenced here, never declared,
# so db-dump never owns (or removes) it.
Secret=materia-mediamanagerDbPassword,type=env,target=PGPASSWORD
Environment=PGCONNECT_TIMEOUT=10
Environment=DB_KIND=postgres
Environment=DB_HOST=mediamanager-postgres
Environment=DB_NAME=mediamanager
Environment=DB_USER=mediamanager
Exec=bash /db-dump.sh

[Service]
# Oneshot pattern copied from restic-backup (BUG-004, #31). Never started by
# materia (Stopped = true); only db-dump-trigger.service restarts it.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1h
