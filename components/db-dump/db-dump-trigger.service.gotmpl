[Unit]
Description=Run every DB dump (restart workaround for RemainAfterExit, see BUG-004)

[Service]
Type=oneshot
# healthchecks.io check db-dump-<host>: /start, then success or /fail.
# Pings never fail the job (- prefix).
ExecStartPre=-/usr/bin/curl -fsS -m 10 --retry 5 -o /dev/null {{ .hcPingURL }}/db-dump-{{ m_facts "host.hostname" }}/start
# restart (not start) re-runs a oneshot that is still active from last
# night, waits for each to finish, and exits non-zero if any fails.
ExecStart=/usr/bin/systemctl restart db-dump-grimmory.service db-dump-mediamanager.service db-dump-silentsuite.service
ExecStopPost=-/usr/bin/bash -c 'url="{{ .hcPingURL }}/db-dump-{{ m_facts "host.hostname" }}"; [ "$$EXIT_STATUS" = "0" ] || url="$$url/fail"; curl -fsS -m 10 --retry 5 -o /dev/null "$$url"'
