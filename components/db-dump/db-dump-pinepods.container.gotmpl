[Unit]
Description=Logical dump of the pinepods database
# Ordering only: a dump must never start a stopped DB. A stopped DB fails
# the dump, and the trigger reports it.
After=pinepods-postgres.service

[Container]
ContainerName=db-dump-pinepods
# Same pin as pinepods-postgres.container.gotmpl, so Renovate bumps both.
Image=docker.io/library/postgres:18.7@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc
Network=newt-net
# Shared label (:z): both dump units write this volume at the same time.
Volume=db-dumps.volume:/dumps:z
Volume={{ m_dataDir "db-dump" }}/dump.bash:/db-dump.sh:ro,z
# Created by the pinepods component; referenced here, never declared,
# so db-dump never owns (or removes) it.
Secret=materia-pinepodsDbPassword,type=env,target=PGPASSWORD
Environment=PGCONNECT_TIMEOUT=10
Environment=DB_KIND=postgres
Environment=DB_HOST=pinepods-postgres
Environment=DB_NAME=pinepods
Environment=DB_USER=pinepods
Exec=bash /db-dump.sh

[Service]
# Oneshot pattern copied from restic-backup (BUG-004, #31). Never started by
# materia (Stopped = true); only db-dump-trigger.service restarts it.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1h
