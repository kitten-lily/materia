[Unit]
Description=Logical dump of the grimmory database
# Ordering only: a dump must never start a stopped DB. A stopped DB fails
# the dump, and the trigger reports it.
After=grimmory-mariadb.service

[Container]
ContainerName=db-dump-grimmory
# Same pin as grimmory-mariadb.container.gotmpl, so Renovate bumps both.
Image=docker.io/library/mariadb:12.3.3@sha256:4ebbcf100a3ba320766dfa0e1af008df12261301db6ef72798c7650f70794aed
Network=newt-net
# Shared label (:z): both dump units write this volume at the same time.
Volume=db-dumps.volume:/dumps:z
Volume={{ m_dataDir "db-dump" }}/dump.sh:/db-dump.sh:ro,z
# Created by the grimmory component; referenced here, never declared, so
# db-dump never owns (or removes) it.
Secret=materia-mariadbRootPassword,type=env,target=MYSQL_PWD
Environment=DB_KIND=mariadb
Environment=DB_HOST=grimmory-mariadb
Environment=DB_NAME=grimmory
Environment=DB_USER=root
Exec=bash /db-dump.sh

[Service]
# Oneshot pattern copied from restic-backup (BUG-004, #31). Never started by
# materia (Stopped = true); only db-dump-trigger.service restarts it.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1h
