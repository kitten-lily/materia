[Unit]
Description=PinePods Valkey
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=pinepods-valkey
# Required by the API, which connects before it listens. Pinned at
# three-part precision so Renovate keeps offering 8.x.y-alpine tags.
Image=docker.io/valkey/valkey:8.1.12-alpine@sha256:9971099af41c36e887aabdfe22b80c0fe45df949163dfc9cb434febc57cfc3fc

# The app reaches it by container name "pinepods-valkey:6379" on newt-net.
# No PublishPort, no auth: only containers on newt-net can reach it.
Network=newt-net

# No volume on purpose (smoke-tested): a replace keeps logins valid and the
# app reconnects by itself. Only a download in flight at that moment is
# lost (re-queue it). Persistence would not save it: the transfer runs in
# the API process.

# JSON form: execs directly, no shell needed.
Notify=healthy
HealthCmd=["valkey-cli","ping"]
HealthInterval=5s
HealthRetries=20
HealthTimeout=5s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
