[Unit]
Description=MediaManager PostgreSQL
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mediamanager-postgres
# Docker Official Image (minimus exit: reg.mini.dev stopped serving anonymous
# pulls around 2026-10-22). Same version as the minimus pin. Official
# POSTGRES_* contract; the entrypoint starts as root and chowns PGDATA to
# postgres (999) itself.
# Take `mise db:backup` before changing this image or the version. A major
# bump needs a pg_dump/pg_upgrade path: the #104 rebuild-in-place only
# worked because the DB was empty then (BUG-010).
Image=docker.io/library/postgres:18.6@sha256:bd5dfa494a5a259704365813dbfa5fa6b3e69be7348d43b547f540c730478583
# REQUIRED. The official 18+ image defaults PGDATA to
# /var/lib/postgresql/18/docker. With data at /var/lib/postgresql/data it
# refuses to start ("there appears to be PostgreSQL data in
# /var/lib/postgresql/data (unused mount/volume)", exit 1), and a failing
# service fails materia-update for the whole host. minimus used this path.
Environment=PGDATA=/var/lib/postgresql/data

# Join newt-net so the app reaches it by container name
# "mediamanager-postgres:5432". No PublishPort — 5432 is never bound on the
# host, reachable only by name on newt-net.
Network=newt-net

Environment=TZ=Etc/UTC
Environment=POSTGRES_DB=mediamanager
Environment=POSTGRES_USER=mediamanager
{{ secretEnv "mediamanagerDbPassword" "POSTGRES_PASSWORD" }}

# Root-owned volume on purpose: the entrypoint runs as root and chowns PGDATA
# to the postgres user itself, so no User=/Group= on the .volume (unlike the
# UID-1000 volumes elsewhere in this repo).
Volume=mediamanager-db.volume:/var/lib/postgresql/data:z

# Gate the app's start on the DB actually accepting connections — see the
# Requires=/After= note in mediamanager.container.gotmpl.
Notify=healthy
HealthCmd=pg_isready -U mediamanager -d mediamanager
HealthInterval=5s
HealthRetries=20
HealthTimeout=5s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
