[Unit]
Description=Tailscale node (kernel mode, host network namespace)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=tailscale
Image=docker.io/tailscale/tailscale:v1.104.4@sha256:ed6480b33c6eb67c9cbd203ed42b9fb57e361986725b6856def71b7a3d9e276c

# Kernel mode in the host netns: tailscale0 and its routes land on the host,
# so containers on podman networks (flutterina's newt, for Pangolin T2
# targets) can route to tailnet IPs. Userspace mode would only make the
# tailnet reachable from inside this container.
Network=host
Environment=TS_USERSPACE=false
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN NET_RAW

# No firewall rules from Tailscale. netavark drives iptables-nft
# ("table ip filter is managed by iptables-nft, do not touch!"), while
# this image's `iptables` is iptables-legacy and Tailscale's nftables mode
# writes native rules into those same ip filter/nat tables. Both mix
# backends. With no host firewall the rules would only add Tailscale's
# 100.64.0.0/10 anti-spoof drop on non-tailscale0 interfaces.
# TS_AUTH_ONCE: these flags apply at first login only (later starts run
# `tailscale set`, which ignores TS_EXTRA_ARGS). Change them on a live node
# with `podman exec tailscale tailscale set ...`.
# flutterina is also a peer relay (#163 phase 1b). Its tags come from
# tailscaleTags in MANIFEST.toml (tag:relay is the relay grant's dst, so the
# policy names no IP). `--relay-server-port` exists only on `tailscale set`,
# so it was applied once by hand,
#   sudo podman exec tailscale tailscale set --relay-server-port=40000
# and lives in tailscale-state.volume. A re-provision (new volume) needs it
# again, plus the udp/40000 rule on the Hetzner firewall.
Environment="TS_EXTRA_ARGS=--advertise-tags={{ m_default "tailscaleTags" "tag:server" }} --netfilter-mode=off"
Environment=TS_AUTH_ONCE=true
Environment=TS_HOSTNAME={{ m_facts "hostname" }}
{{- if exists "tailscaleMagicDns" }}

# Opt-in per host (tailscaleMagicDns in MANIFEST.toml): MagicDNS on the
# HOST, via systemd-resolved over D-Bus, so the host resolves *.ts.net
# names (e.g. Tailscale Services). Both binds are needed: with only the
# D-Bus socket, tailscaled sees podman's rewritten resolv.conf (no resolved
# stub marker), picks "direct" mode and edits only the container's file.
# The host's stub file makes it choose "systemd-resolved" mode; in the host
# netns 127.0.0.53 is still the host's resolver. A missing bind source
# fails the unit, so hosts without systemd-resolved must not opt in.
# TS_ACCEPT_DNS is re-applied by `tailscale set` on every start.
Environment=TS_ACCEPT_DNS=true
Volume=/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
Volume=/run/systemd/resolve/stub-resolv.conf:/etc/resolv.conf:ro
{{- end }}

# OAuth client secret with ?ephemeral=false&preauthorized=true stored in the
# value itself; without that suffix the node registers as ephemeral and is
# deleted (and later renumbered) whenever it goes offline.
{{ secretEnv "tailscaleAuthKey" "TS_AUTHKEY" }}

# Node identity and keys. Losing this volume registers a new node with a
# new tailnet IP, which breaks every Pangolin target that points at it.
Environment=TS_STATE_DIR=/var/lib/tailscale
Volume=tailscale-state.volume:/var/lib/tailscale:Z

# /healthz returns 200 once the node has tailnet IPs. Bound to loopback:
# with Network=host the default [::]:9002 would listen on the public
# interface. No HealthOnFailure= — health tracks the control plane, and a
# coordination outage must not become a restart loop.
Environment=TS_ENABLE_HEALTH_CHECK=true
Environment=TS_LOCAL_ADDR_PORT=127.0.0.1:9002
HealthCmd=wget -q -O /dev/null http://127.0.0.1:9002/healthz
HealthInterval=60s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
