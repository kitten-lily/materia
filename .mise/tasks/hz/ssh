#!/usr/bin/env bash
#MISE description="SSH into a server as core@<ip> (tailnet IP when it is an online peer, else public IP)"
#USAGE flag "--server-name <name>" help="Server name"

set -euo pipefail

_server_name="${usage_server_name:?server name required, use --server-name}"

IFS=$'\t' read -r _id _ip < <(mise hz:_server-id --server-name "$_server_name" 2>/dev/null)

if [[ -z "$_ip" ]]; then
  gum style --foreground 1 "error: no server named '$_server_name'"
  exit 1
fi

# SSH over the tailnet when the server is an online peer: flutterina's
# Hetzner firewall has no public tcp/22 (#163).
_tip=$(mise hz:_tailnet-ip --server-name "$_server_name" 2>/dev/null || true)
_ip="${_tip:-$_ip}"

exec ssh "core@$_ip"
