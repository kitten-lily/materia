#!/usr/bin/env bash
#MISE description="Generate SilentSuite's vault secrets on bow (DB password, ini fragment, bootstrap token), or with --close the registration token that closes signups (#192)"

#USAGE flag "--vault <vault>" help="SOPS vault to write" default="attributes/bow.yml"
#USAGE flag "--close" help="Only add silentsuiteRegistrationToken (closes signups after the first account)"

# Refuses to overwrite any key it would write: a new DB password locks the
# server out of an already initialised Postgres cluster. Values are
# generated here and written with `sops --set` (jq-encoded, never pasted by
# hand, BUG-003). Only the bootstrap token is printed, once: the first
# signup needs it in the server URL (?bootstrap_token=...). It also stays in
# the vault.
#
# The DB password is stored twice: bare for Postgres (POSTGRES_PASSWORD), and
# as an ini fragment the server merges over its templated ini, which has no
# password (ETEBASE_EASY_CONFIG_PATH, see specs/plans/silentsuite-investigation.md).

set -euo pipefail

_vault="${usage_vault:-attributes/bow.yml}"
_close="${usage_close:-false}"
[[ -f $_vault ]] || { echo "error: $_vault not found" >&2; exit 1; }

# fnox.toml sets env = false, so sops needs the age key fetched explicitly.
SOPS_AGE_KEY="${SOPS_AGE_KEY:-$(fnox get SOPS_AGE_KEY)}"
export SOPS_AGE_KEY

path() { printf '["components"]["silentsuite"]["%s"]' "$1"; }
has() { sops decrypt --extract "$(path "$1")" "$_vault" >/dev/null 2>&1; }
put() { sops set "$_vault" "$(path "$1")" "$(printf %s "$2" | jq -Rs .)"; }
token() { head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40; }

if [[ $_close == true ]]; then
  keys=(silentsuiteRegistrationToken)
else
  keys=(silentsuiteDbPassword silentsuiteDbIni silentsuiteBootstrapToken)
fi
for k in "${keys[@]}"; do
  if has "$k"; then
    echo "error: $k already exists in $_vault; refusing to overwrite it" >&2
    exit 1
  fi
done

if [[ $_close == true ]]; then
  # Nobody holds this token: no client can send it, so this closes signups.
  # To add an account later: remove it, sign up, run --close again.
  put silentsuiteRegistrationToken "$(token)"
  echo "silentsuiteRegistrationToken written to $_vault: signups close at the next materia run"
  exit 0
fi

pw=$(token)
boot=$(token)
put silentsuiteDbPassword "$pw"
# Built without $(...), which would strip the trailing newline.
ini=$'[database]\npassword = '"$pw"$'\n'
put silentsuiteDbIni "$ini"
put silentsuiteBootstrapToken "$boot"
unset pw ini
echo "silentsuite secrets written to $_vault."
echo "First signup server URL: https://silentsuite.<baseDomain>/?bootstrap_token=$boot"
