#!/usr/bin/env bash
# shellcheck disable=SC2054 # commas belong to the QEMU options
#MISE description="Create, install, start and stop the local Bluefin pilot VMs on the workstation (#179)"

#USAGE arg "<action>" help="create | install | start | rehearse | stop | destroy | status"
#USAGE flag "--vm <name>" help="Pilot VM: bluefin-pilot-cp, bluefin-pilot-node or bluefin-pilot-edge"
#USAGE flag "--size <bytes>" help="create: exact OS disk size in bytes (edge only, required)"
#USAGE flag "--fresh" help="rehearse: replace the previous rehearsal disk and firmware variables"
#USAGE flag "--resume" help="rehearse: boot the existing rehearsal disk again"
#USAGE flag "--no-reboot" help="start: exit QEMU on the first guest reset"
#USAGE flag "--offline" help="start: bring up both NICs with the link down (recovery check L1)"
#USAGE flag "--topology <topology>" default="lan" help="start: lan (Phase 1: shared segment) or tailnet (Phase 2: one NIC, Tailscale auth key, denial-probe forwards)"
#USAGE flag "--without-data <n>" help="start: leave data disk n detached (Phase 3 missing-disk test)"
#USAGE flag "--reinstall" help="install: firmware already holds the Bluefin keys; skip the enroll stage (recovery procedure L3)"

# Design: specs/plans/bluefin-server-pilot-phase1.md ("Tooling", "Machines and
# network"). Everything lives under ~/.cache/bluefin-pilot/vm/<vm>/; nothing
# here touches a block device or any path outside that directory.
#
# install = stage 1 (enroll Secure Boot keys) + stage 2 (unattended install);
# both run with -no-reboot so each guest reset ends QEMU. start = stage 3, the
# configured boot of the installed disk with every credential present from its
# very first boot (systemd-firstboot applies passwd.* only then).

set -euo pipefail
umask 077

_action="${usage_action:?action required}"
_vm="${usage_vm:?pilot VM required, use --vm}"
[[ "$_vm" =~ ^bluefin-pilot-[a-z0-9-]+$ ]] || { echo "error: refusing non-pilot name '$_vm'" >&2; exit 1; }
_os_format=qcow2
case "$_vm" in
  bluefin-pilot-cp)   _cpus=4; _mem=8192; _os_size=64G; _data=(8G 8G); _ssh=2210; _id=10; _probe=2 ;;
  bluefin-pilot-node) _cpus=2; _mem=4096; _os_size=40G; _data=(8G);    _ssh=2211; _id=11; _probe=3 ;;
  bluefin-pilot-edge) _cpus=2; _mem=4096; _data=(); _ssh=2212; _id=12; _probe=4; _os_format=raw ;;
  *) echo "error: unknown pilot VM '$_vm'" >&2; exit 1 ;;
esac

_rel=v26.11.2506
_cache="${HOME}/.cache/bluefin-pilot"
_dir="${_cache}/vm/${_vm}"
_os="os.${_os_format}"
_render="${_cache}/render/${_vm}"
_installer="${_cache}/${_rel}/bluefin-server-installer_26.11.2506.raw"
_installer_sha=68bac3c0e9ab4312b3e1d1d1a7b786916253fe619b30db0d0fe8c1da3525db14
_code=/usr/share/edk2/ovmf/OVMF_CODE_4M.secboot.fd
_vars_tmpl=/usr/share/edk2/ovmf/OVMF_VARS_4M.secboot.fd
_mac_wan="52:54:00:77:01:${_id}"
_mac_lan="52:54:00:77:00:${_id}"
_mcast=230.77.0.1:7700

case "$_dir" in "${_cache}/vm/bluefin-pilot-"*) ;; *) echo "error: bad VM dir $_dir" >&2; exit 1 ;; esac

# SMBIOS type 11 credential, as upstream's dogfood-installer.sh passes them.
cred() { printf 'type=11,value=io.systemd.credential.binary:%s=%s' "$1" "$(base64 -w0 < "$2")"; }

running() { [[ -f "${_dir}/qemu.pid" ]] && kill -0 "$(cat "${_dir}/qemu.pid")" 2>/dev/null; }

qmp() {
  python3 -I - "${_dir}/qmp.sock" "$@" <<'EOF'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw"); f.readline()
for cmd in [{"execute": "qmp_capabilities"}] + [json.loads(a) for a in sys.argv[2:]]:
    f.write(json.dumps(cmd) + "\n"); f.flush()
    while True:
        r = json.loads(f.readline())
        if "event" not in r:
            break
    if "error" in r:
        print(json.dumps(r["error"]), file=sys.stderr); sys.exit(1)
EOF
}

# Firmware, machine and disks common to every run.
base_args() {
  local disk="${1:-$_os}" vars="${2:-vars.fd}" serial="${3:-serial.log}" i
  _args=(qemu-system-x86_64 -name "$_vm" -machine q35,smm=on,accel=kvm -cpu host
    -smp "$_cpus" -m "$_mem"
    -global driver=cfi.pflash01,property=secure,value=on
    -drive "if=pflash,format=raw,unit=0,readonly=on,file=${_code}"
    -drive "if=pflash,format=raw,unit=1,file=${_dir}/${vars}"
    -drive "file=${_dir}/${disk},if=none,id=os,format=${_os_format}")
  if [[ "$disk" == rehearse.raw ]]; then
    _args+=(-device virtio-scsi-pci,id=scsi0 -device scsi-hd,drive=os,bus=scsi0.0)
  else
    _args+=(-device virtio-blk-pci,drive=os,serial=bluefin-os)
  fi
  for i in "${!_data[@]}"; do
    [[ "${usage_without_data:-}" == "$((i + 1))" ]] && { echo "data disk $((i + 1)) left detached"; continue; }
    _args+=(-drive "file=${_dir}/data$((i + 1)).qcow2,if=none,id=data$((i + 1)),format=qcow2"
      -device "virtio-blk-pci,drive=data$((i + 1)),serial=bluefin-data$((i + 1))")
  done
  _args+=(-display none -vga std
    -serial "file:${_dir}/${serial}" -serial "file:${_dir}/probe.log"
    -qmp "unix:${_dir}/qmp.sock,server,nowait")
}

ssh_net_args() {
  _args+=(-netdev "user,id=wan,hostfwd=tcp:127.0.0.1:${_ssh}-:22"
    -device "virtio-net-pci,netdev=wan,mac=${_mac_wan}")
}

net_args() {
  if [[ "${usage_topology:-lan}" == tailnet ]]; then
    # One NIC only (no shared segment). Extra forwards from the workstation's
    # loopback to guest 6443/6447/10250 (tcp) and 8472 (udp) on this non-tailnet
    # NIC are the Phase 2 denial probes (design, "Denial tests"):
    # ${_probe}6443 ${_probe}6447 ${_probe}0250 tcp, ${_probe}8472 udp.
    _args+=(-netdev "user,id=wan,hostfwd=tcp:127.0.0.1:${_ssh}-:22,hostfwd=tcp:127.0.0.1:${_probe}6443-:6443,hostfwd=tcp:127.0.0.1:${_probe}6447-:6447,hostfwd=tcp:127.0.0.1:${_probe}0250-:10250,hostfwd=udp:127.0.0.1:${_probe}8472-:8472"
      -device "virtio-net-pci,netdev=wan,mac=${_mac_wan}")
  else
    ssh_net_args
    _args+=(-netdev "socket,id=lan,mcast=${_mcast},localaddr=127.0.0.1"
      -device "virtio-net-pci,netdev=lan,mac=${_mac_lan}")
  fi
}

firstboot_creds() {
  local kv
  for kv in firstboot.locale=C.UTF-8 firstboot.keymap=us firstboot.timezone=UTC; do
    printf '%s' "${kv#*=}" > "${_dir}/cred-${kv%%=*}"
    _args+=(-smbios "$(cred "${kv%%=*}" "${_dir}/cred-${kv%%=*}")")
  done
  if [[ "$_vm" != bluefin-pilot-edge ]]; then
    _args+=(-smbios "$(cred passwd.hashed-password.root "${_render}/passwd.hashed-password.root")")
  fi
}

daemonize() {
  printf '%s\n' "$1" > "${_dir}/active-disk" || return
  "${_args[@]}" -daemonize -pidfile "${_dir}/qemu.pid"
}

show_ssh() {
  echo "started ${_vm} (pid $(cat "${_dir}/qemu.pid")); ssh -i ~/.cache/bluefin-pilot/secrets/ssh-root -p ${_ssh} root@127.0.0.1"
}

case "$_action" in
create)
  if [[ "$_vm" == bluefin-pilot-edge ]]; then
    _size="${usage_size:-}"
    if [[ ! "$_size" =~ ^[0-9]+$ ]]; then
      echo "error: edge create requires --size in positive integer bytes" >&2
      exit 1
    fi
    # Normalize leading zeroes and check the maximum before Bash arithmetic.
    _size="${_size#"${_size%%[!0]*}"}"
    _max_size=9223372036854775807
    # shellcheck disable=SC2071 # compare equal-length digit strings without overflow
    if [[ -z "$_size" || ${#_size} -gt ${#_max_size} ||
          ( ${#_size} -eq ${#_max_size} && "$_size" > "$_max_size" ) ]] || (( _size % 512 != 0 )); then
      echo "error: --size must be a positive byte count divisible by 512 and fit in a signed 64-bit integer" >&2
      exit 1
    fi
  elif [[ -v usage_size ]]; then
    echo "error: --size is only supported for bluefin-pilot-edge" >&2
    exit 1
  fi
  [[ -e "${_dir}/${_os}" || -L "${_dir}/${_os}" ]] && { echo "error: ${_dir} already exists; destroy it first" >&2; exit 1; }
  mkdir -p "$_dir"
  chmod 700 "$_dir"
  if [[ "$_os_format" == raw ]]; then
    truncate -s "$_size" -- "${_dir}/${_os}"
    stat -c %s -- "${_dir}/${_os}" > "${_dir}/size"
  else
    qemu-img create -q -f qcow2 "${_dir}/${_os}" "$_os_size"
  fi
  for i in "${!_data[@]}"; do qemu-img create -q -f qcow2 "${_dir}/data$((i + 1)).qcow2" "${_data[$i]}"; done
  cp "$_vars_tmpl" "${_dir}/vars.fd"
  echo "created ${_dir}"
  ;;

install)
  running && { echo "error: $_vm is running" >&2; exit 1; }
  [[ -f "${_dir}/${_os}" && -f "${_dir}/vars.fd" ]] || { echo "error: run create first" >&2; exit 1; }
  # USB installs normally ask for a console password on the installed disk.
  _root_prompt=
  if [[ "$_vm" != bluefin-pilot-edge ]]; then
    [[ -s "${_render}/passwd.hashed-password.root" ]] || { echo "error: run bluefin:pilot:render first" >&2; exit 1; }
    _root_prompt=" --set-credential=bluefin.prompt-root-password:1"
  fi
  echo "verifying installer sha256..."
  echo "${_installer_sha}  ${_installer}" | sha256sum --check --quiet
  rm -f "${_dir}/installer.qcow2"
  qemu-img create -q -f qcow2 -F raw -b "$_installer" "${_dir}/installer.qcow2"

  # Unattended sysinstall drop-in: the image drop-in's ExecStart plus
  # --confirm=no and the OS disk by its virtio serial (never /dev/vdX).
  _target=/dev/disk/by-id/virtio-bluefin-os
  cat > "${_dir}/sysinstall.conf" <<EOF
[Service]
StandardInput=null
StandardError=journal+console
ExecStart=
ExecStart=systemd-sysinstall --variables=yes --erase=yes --reboot=no --mute-console=yes --definitions=/run/bluefin/installer/bluefin/repart.d --kernel=\${BLUEFIN_INSTALL_KERNEL}${_root_prompt} --confirm=no ${_target}
ExecStopPost=/bin/bash -c 'echo "PROBE sysinstall=\$\${SERVICE_RESULT} \$\${EXIT_STATUS}" > /dev/ttyS1; lsblk -o NAME,PARTLABEL,FSTYPE,SIZE ${_target} > /dev/ttyS1 2>&1'
EOF

  _stages=(enroll install); [[ -n "${usage_reinstall:-}" ]] && _stages=(install)
  for stage in "${_stages[@]}"; do
    : > "${_dir}/serial.log"; : > "${_dir}/probe.log"
    base_args
    _args+=(-drive "file=${_dir}/installer.qcow2,if=none,id=usb0,format=qcow2"
      -device qemu-xhci -device usb-storage,drive=usb0,bootindex=0
      -nic none -no-reboot
      -smbios "$(cred systemd.unit-dropin.systemd-sysinstall.service "${_dir}/sysinstall.conf")")
    firstboot_creds
    echo "stage ${stage}: booting installer (QEMU exits on the guest's reset)..."
    if ! timeout 1500 "${_args[@]}"; then
      echo "error: stage ${stage} did not end with a reset within 25 min; see ${_dir}/serial.log" >&2; exit 1
    fi
    cp "${_dir}/serial.log" "${_dir}/serial-${stage}.log"; cp "${_dir}/probe.log" "${_dir}/probe-${stage}.log"
    if [[ "$stage" == enroll ]]; then
      grep -q "successfully enrolled" "${_dir}/serial.log" \
        || { echo "error: stage enroll ended without key enrollment; see serial-enroll.log" >&2; exit 1; }
      echo "stage enroll: Secure Boot keys enrolled"
    fi
  done
  grep -q 'PROBE sysinstall=success 0' "${_dir}/probe-install.log" \
    || { echo "error: sysinstall did not report success; see probe-install.log and serial-install.log" >&2; exit 1; }
  rm -f "${_dir}/installer.qcow2"
  echo "installed. probe:"; sed 's/^/  /' "${_dir}/probe-install.log"
  ;;

start)
  [[ "$_vm" != bluefin-pilot-edge ]] || { echo "error: use rehearse for bluefin-pilot-edge" >&2; exit 1; }
  running && { echo "error: $_vm is already running" >&2; exit 1; }
  [[ -s "${_render}/config.ign" ]] || { echo "error: run bluefin:pilot:render first" >&2; exit 1; }
  [[ -e "${_dir}/installer.qcow2" ]] && { echo "error: installer overlay still present; install did not finish" >&2; exit 1; }
  : > "${_dir}/serial.log"; : > "${_dir}/probe.log"
  base_args; net_args
  # Ignition goes in as a fw_cfg file credential, not inline SMBIOS: with the
  # pilot-lvm2 sysext embedded (Phase 3) the config is ~1.4 MB, and one argv
  # string is limited to 128 KiB ("Argument list too long"). qemu_fw_cfg is
  # built into Bluefin's kernel, so PID 1 imports it in the initrd as well.
  _args+=(-fw_cfg "name=opt/io.systemd.credentials/ignition.config,file=${_render}/config.ign")
  firstboot_creds
  [[ -s "${_render}/bluefin-cluster.passphrase" ]] \
    && _args+=(-smbios "$(cred bluefin-cluster.passphrase "${_render}/bluefin-cluster.passphrase")")
  [[ -n "${usage_no_reboot:-}" ]] && _args+=(-no-reboot)
  # Phase 2: the Tailscale auth key as a fw_cfg credential from a short-lived
  # file (QEMU reads it at startup), so it is never in QEMU's argv or in the
  # render directory.
  _keyfile=""
  if [[ "${usage_topology:-lan}" == tailnet ]]; then
    _keyfile="$(mktemp "${_dir}/.authkey.XXXXXX")"
    pass-cli item view --vault-name bluefin-pilot --item-title tailscale-auth-key --field key | tr -d '\n' > "$_keyfile"
    [[ "$(head -c11 "$_keyfile")" == tskey-auth- ]] || { rm -f "$_keyfile"; echo "error: tailscale-auth-key not readable from the pilot vault" >&2; exit 1; }
    _args+=(-fw_cfg "name=opt/io.systemd.credentials/pilot.tailscale-authkey,file=${_keyfile}")
  fi
  _rc=0; daemonize "$_os" || _rc=$?
  [[ -n "$_keyfile" ]] && rm -f "$_keyfile"
  [[ $_rc -eq 0 ]] || { echo "error: QEMU failed to start (exit $_rc)" >&2; exit "$_rc"; }
  if [[ -n "${usage_offline:-}" ]]; then
    qmp '{"execute":"set_link","arguments":{"name":"wan","up":false}}' '{"execute":"set_link","arguments":{"name":"lan","up":false}}'
    echo "both NICs link down"
  fi
  show_ssh
  ;;

rehearse)
  [[ "$_vm" == bluefin-pilot-edge ]] || { echo "error: rehearse requires --vm bluefin-pilot-edge" >&2; exit 1; }
  running && { echo "error: $_vm is already running" >&2; exit 1; }
  [[ -e "${_dir}/installer.qcow2" ]] && { echo "error: installer overlay still present; install did not finish" >&2; exit 1; }
  [[ -f "${_dir}/${_os}" ]] || { echo "error: run create and install first" >&2; exit 1; }
  if [[ "${usage_resume:-false}" == true ]]; then
    # Boot the existing rehearsal disk again (its tailnet identity and join
    # state intact), e.g. to re-test bootstrap without spending an auth key.
    [[ "${usage_fresh:-false}" == true ]] && { echo "error: --resume and --fresh exclude each other" >&2; exit 1; }
    [[ -f "${_dir}/rehearse.raw" && -f "${_dir}/rehearse-vars.fd" ]] \
      || { echo "error: no rehearsal disk to resume; run rehearse first" >&2; exit 1; }
  else
    if [[ "${usage_fresh:-false}" == true ]]; then
      rm -f -- "${_dir}/rehearse.raw" "${_dir}/rehearse-vars.fd"
    elif [[ -e "${_dir}/rehearse.raw" || -L "${_dir}/rehearse.raw" ||
            -e "${_dir}/rehearse-vars.fd" || -L "${_dir}/rehearse-vars.fd" ]]; then
      echo "error: rehearsal files already exist; use --fresh to replace them or --resume to boot them" >&2
      exit 1
    fi
    cp --sparse=always -- "${_dir}/${_os}" "${_dir}/rehearse.raw"
    cp -- "$_vars_tmpl" "${_dir}/rehearse-vars.fd"
  fi
  : > "${_dir}/rehearse-serial.log"; : > "${_dir}/probe.log"
  base_args rehearse.raw rehearse-vars.fd rehearse-serial.log
  ssh_net_args
  daemonize rehearse.raw
  show_ssh
  ;;

stop)
  running || { echo "$_vm is not running"; exit 0; }
  qmp '{"execute":"system_powerdown"}'
  for _ in $(seq 1 60); do running || { echo "stopped"; exit 0; }; sleep 2; done
  echo "no clean shutdown after 120 s; forcing"; qmp '{"execute":"quit"}' || true
  ;;

destroy)
  running && { echo "error: stop $_vm first" >&2; exit 1; }
  [[ -d "$_dir" ]] || { echo "nothing to destroy"; exit 0; }
  rm -rf -- "$_dir"
  echo "destroyed ${_dir}"
  ;;

status)
  if running; then
    _disk="$_os"
    [[ ! -f "${_dir}/active-disk" ]] || _disk="$(cat "${_dir}/active-disk")"
    echo "$_vm running (pid $(cat "${_dir}/qemu.pid")), disk ${_disk}, ssh port ${_ssh}"
  else
    echo "$_vm not running"
  fi
  shopt -s nullglob
  _disks=("$_dir"/*.qcow2 "$_dir"/*.raw)
  if (( ${#_disks[@]} )); then du -sh -- "${_disks[@]}"; fi
  ;;

*) echo "error: unknown action '$_action'" >&2; exit 1 ;;
esac
