#!/usr/bin/env bash
#MISE description="Back up the grimmory MariaDB + MediaManager/PinePods/SilentSuite Postgres databases on a host (logical dump, row counts, raw volume), or compare row counts against an earlier backup"

#USAGE flag "--target <target>" required=#true help="ssh destination of the host (user@host), e.g. core@bow"
#USAGE flag "--compare <compare>" help="backup directory from an earlier run (/var/lib/db-backups/<stamp>): only re-count rows and diff against it"

# Run before any change that rewrites a database's image or data directory
# (BUG-010: a host-side step that only lives in prose does not happen). One
# ssh session does everything on the host, as root.
#
# Per database whose container is running:
#   1. Logical dump: mariadb-dump --all-databases / pg_dumpall. It runs from a
#      throwaway official client container on newt-net, reading the
#      component's existing materia podman secret. It doesn't depend on
#      what the server image ships.
#   2. Exact per-table row counts (<db>.counts).
#   3. Raw volume export: stops the DB (its app goes too, via Requires=),
#      runs `podman volume export`, then starts the app (which starts the DB).
#      This is a few seconds of app downtime.
#
# Output: /var/lib/db-backups/<UTC stamp>/ (root, 0700), on the root disk,
# not the data LV. --compare re-counts rows and fails if a table is missing
# or has fewer rows than in the backup.

set -euo pipefail

_target="${usage_target:?--target is required}"
_compare="${usage_compare:-}"

read -r -d '' _payload <<'PAYLOAD_EOF' || true
set -euo pipefail
# name|kind|container|db service|app service|podman secret|volume|db user|db name|server quadlet
# db name: the Postgres database counts connect to and pg_dumpall starts
# from (#201); unused for mariadb, which dumps --all-databases.
# The client image is read from the installed server quadlet, so it is
# always the pin Renovate last bumped (this task has no pins of its own).
DBS=(
  "grimmory|mariadb|grimmory-mariadb|grimmory-mariadb.service|grimmory.service|materia-mariadbRootPassword|systemd-grimmory-mariadb-config|root|grimmory|/etc/containers/systemd/grimmory/grimmory-mariadb.container"
  "mediamanager|postgres|mediamanager-postgres|mediamanager-postgres.service|mediamanager.service|materia-mediamanagerDbPassword|systemd-mediamanager-db|mediamanager|mediamanager|/etc/containers/systemd/mediamanager/mediamanager-postgres.container"
  "silentsuite|postgres|silentsuite-postgres|silentsuite-postgres.service|silentsuite.service|materia-silentsuiteDbPassword|systemd-silentsuite-db|silentsuite|silentsuite|/etc/containers/systemd/silentsuite/silentsuite-postgres.container"
  "pinepods|postgres|pinepods-postgres|pinepods-postgres.service|pinepods.service|materia-pinepodsDbPassword|systemd-pinepods-db|pinepods|pinepods|/etc/containers/systemd/pinepods/pinepods-postgres.container"
)

step() { echo "==> $*"; }
fail() { echo "error: $*" >&2; exit 1; }

# Image= of an installed quadlet.
image_of() { sed -n 's/^Image=//p' "$1" | head -1; }

# Exact row count per table, "<schema>.<table> <count>", sorted.
counts() {
  local kind=$1 ctr=$2 secret=$3 user=$4 db=$5 img=$6
  case "$kind" in
    mariadb)
      podman run --rm --network newt-net --secret "$secret,type=env,target=MYSQL_PWD" "$img" sh -c "
        mariadb -h $ctr -u$user -N -e \"SELECT CONCAT('SELECT ''', table_schema, '.', table_name, ''', COUNT(*) FROM \\\`', table_schema, '\\\`.\\\`', table_name, '\\\`;') FROM information_schema.tables WHERE table_type = 'BASE TABLE' AND table_schema NOT IN ('mysql', 'information_schema', 'performance_schema', 'sys')\" \
        | mariadb -h $ctr -u$user -N" | sort ;;
    postgres)
      podman run --rm --network newt-net --secret "$secret,type=env,target=PGPASSWORD" "$img" sh -c "
        psql -h $ctr -U $user -d $db -Atc \"SELECT format('SELECT %L || chr(9) || count(*) FROM %I.%I;', schemaname || '.' || relname, schemaname, relname) FROM pg_stat_user_tables\" \
        | psql -h $ctr -U $user -d $db -At" | sort ;;
  esac
}

dump() {
  local kind=$1 ctr=$2 secret=$3 user=$4 db=$5 img=$6
  case "$kind" in
    mariadb)
      podman run --rm --network newt-net --secret "$secret,type=env,target=MYSQL_PWD" "$img" \
        mariadb-dump -h "$ctr" -u"$user" --all-databases --single-transaction --routines --events --triggers ;;
    postgres)
      podman run --rm --network newt-net --secret "$secret,type=env,target=PGPASSWORD" "$img" \
        pg_dumpall -h "$ctr" -U "$user" -l "$db" ;;
  esac
}

running() { [[ "$(podman inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == true ]]; }

if [[ -n "$COMPARE" ]]; then
  [[ -d "$COMPARE" ]] || fail "no such backup directory: $COMPARE"
  rc=0
  for entry in "${DBS[@]}"; do
    IFS='|' read -r name kind ctr _svc _app secret _vol user db quadlet <<<"$entry"
    [[ -f "$COMPARE/$name.counts" ]] || { echo "    skip  $name (not in backup)"; continue; }
    running "$ctr" || { echo "    FAIL  $name: container $ctr not running"; rc=1; continue; }
    step "$name: comparing row counts with $COMPARE/$name.counts"
    # Guard the file first: under set -e/pipefail, image_of on a missing file
    # would exit inside the command substitution before any message.
    [[ -r $quadlet ]] || { echo "    FAIL  $name: $quadlet missing"; rc=1; continue; }
    img=$(image_of "$quadlet")
    [[ -n $img ]] || { echo "    FAIL  $name: no Image= in $quadlet"; rc=1; continue; }
    counts "$kind" "$ctr" "$secret" "$user" "$db" "$img" > "/tmp/$name.counts.now"
    # Fail on a missing table or fewer rows; more rows is normal app activity.
    awk -F '\t' -v name="$name" '
      NR == FNR { before[$1] = $2; next }
      { now[$1] = $2 }
      END {
        bad = 0
        for (t in before) {
          if (!(t in now)) { printf "    FAIL  %s: table %s missing\n", name, t; bad = 1 }
          else if (now[t] + 0 < before[t] + 0) { printf "    FAIL  %s: %s %d -> %d rows\n", name, t, before[t], now[t]; bad = 1 }
        }
        if (!bad) printf "    ok    %s: %d tables, none missing, no row loss\n", name, length(before)
        exit bad
      }' "$COMPARE/$name.counts" "/tmp/$name.counts.now" || rc=1
    rm -f "/tmp/$name.counts.now"
  done
  exit "$rc"
fi

dir="/var/lib/db-backups/$(date -u +%Y%m%dT%H%M%SZ)"
install -d -m 0700 "$dir"
step "backing up into $dir (free on /: $(df -h --output=avail / | tail -1 | tr -d ' '))"
for entry in "${DBS[@]}"; do
  IFS='|' read -r name kind ctr svc app secret vol user db quadlet <<<"$entry"
  if ! running "$ctr"; then echo "    skip  $name ($ctr not running on this host)"; continue; fi

  step "$name: logical dump"
  [[ -r $quadlet ]] || fail "$name: $quadlet missing"
  img=$(image_of "$quadlet"); [[ -n $img ]] || fail "$name: no Image= in $quadlet"
  ( umask 077; dump "$kind" "$ctr" "$secret" "$user" "$db" "$img" > "$dir/$name.sql" )
  [[ -s "$dir/$name.sql" ]] || fail "$name: empty dump"
  step "$name: row counts"
  counts "$kind" "$ctr" "$secret" "$user" "$db" "$img" > "$dir/$name.counts"
  echo "    $(wc -l < "$dir/$name.counts") tables, $(awk -F '\t' '{s += $2} END {print s + 0}' "$dir/$name.counts") rows"

  step "$name: raw volume export (stops $app and $svc briefly)"
  systemctl stop "$svc"
  rc=0; ( umask 077; podman volume export "$vol" -o "$dir/$name-volume.tar" ) || rc=$?
  systemctl start "$app"
  [[ $rc == 0 ]] || fail "$name: volume export failed (services restarted)"
done
ls -lh "$dir"
echo "backup: $dir"
PAYLOAD_EOF

_script="COMPARE=$(printf %q "$_compare")"$'\n'"$_payload"
echo "==> $_target (ssh may wait for a security-key touch)"
# shellcheck disable=SC2029 # expanded locally on purpose
ssh "$_target" "sudo bash -c $(printf %q "$_script")"
