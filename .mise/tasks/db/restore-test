#!/usr/bin/env bash
#MISE description="Restore a host's latest restic snapshot of its DB dumps (bow: db-dump; flutterina: sqlite-dump) and app volumes into throwaway containers and check them (#194, #195)"

#USAGE flag "--target <target>" required=#true help="ssh destination of the host (user@host), e.g. core@bow"
#USAGE flag "--snapshot <snapshot>" help="restic snapshot ID to test instead of this host's latest (e.g. to prove the freshness check fails)"

# Proves the nightly db-dump output can be restored from the off-host restic
# repository, not just that it was written. One ssh session, as root:
#   1. Resolve ONE snapshot (this host's latest, or --snapshot) and use its ID
#      for every read, never "latest".
#   2. Every <name>.done in that snapshot must be <= 36 h old: a fresh
#      snapshot of a stale dump must fail.
#   3. Load each <name>.sql into a throwaway server (same image as the
#      installed server quadlet, initialised by the same env, private network,
#      no volume), stopping at the first SQL error. The restored table set must
#      equal <name>.counts.pre, and each table's rows must lie in [pre, post].
#   4. Restore each app volume and compare sha256 of every file that hasn't
#      changed since the snapshot with the live copy.
# restic runs from the restic-backup image with the installed quadlet's own
# env, secrets and mounts. Nothing on the host is modified; all scratch state
# is removed on exit.

set -euo pipefail

_target="${usage_target:?--target is required}"
_snapshot="${usage_snapshot:-}"

read -r -d '' _payload <<'PAYLOAD_EOF' || true
set -euo pipefail
# Host paths. The env overrides exist only for the local test harness (#200);
# on a host none is set.
VOLS=${VOLS:-/var/lib/containers/storage/volumes}
RQ=${RQ:-/etc/containers/systemd/restic-backup/restic-backup.container}
QDIR=${DBS_QUADLET_DIR:-/etc/containers/systemd}
DUMP_SCRIPT=${DUMP_SCRIPT:-/var/lib/materia/components/sqlite-dump/dump.cjs}
# Chosen per host once RESTIC_HOST is known (#195); empty until then so the
# exit trap can always run.
DBS=()
MAX_AGE_H=36

step() { echo "==> $*"; }
pass() { echo "    ok    $*"; }
FAILED=0
flunk() { echo "    FAIL  $*"; FAILED=1; }

work=$(mktemp -d /var/tmp/restore-test.XXXXXX)
net=restore-test-$$
cleanup() {
  # -v: both official images declare a VOLUME, so each throwaway server has an
  # anonymous volume holding the restored database. Without -v it outlives the
  # container on the root disk, and restic then backs it up off-host.
  # Every server in DBS (named $net-<name>), not a hand-kept list: a new
  # entry would otherwise leave its server and restored data behind.
  local entry
  for entry in "${DBS[@]}"; do
    podman rm -f -v "$net-${entry%%|*}" >/dev/null 2>&1 || true
  done
  podman network rm "$net" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# --- restic with the installed job's own configuration ----------------------
image_of() { sed -n 's/^Image=//p' "$1" | head -1; }
rargs=(--rm --tmpfs /tmp)
while IFS= read -r line; do
  case $line in
    Environment=*) v=${line#Environment=}; v=${v#\"}; v=${v%\"}; rargs+=(--env "$v") ;;
    Secret=*) rargs+=(--secret "${line#Secret=}") ;;
    Volume=*) rargs+=(-v "${line#Volume=}") ;;
  esac
done < "$RQ"
RIMG=$(image_of "$RQ")
RHOST=$(sed -n 's/^Environment=RESTIC_HOST=//p' "$RQ")
restic() { podman run "${rargs[@]}" -v "$work:/work" --entrypoint restic "$RIMG" --no-cache "$@"; }

# --- per-host configuration (#195) ---------------------------------------------
# name|kind|quadlet giving the image|db user|hub quadlet (sqlite only, or -)
case $RHOST in
  bow)
    DUMPS=$VOLS/systemd-db-dumps/_data
    DBS=(
      "grimmory|mariadb|$QDIR/grimmory/grimmory-mariadb.container|grimmory|-"
      "mediamanager|postgres|$QDIR/mediamanager/mediamanager-postgres.container|mediamanager|-"
      "silentsuite|postgres|$QDIR/silentsuite/silentsuite-postgres.container|silentsuite|-"
      "pinepods|postgres|$QDIR/pinepods/pinepods-postgres.container|pinepods|-"
    )
    default_apps="systemd-grimmory-data systemd-mediamanager-images systemd-silentsuite-data" ;;
  flutterina)
    # sqlite-dump's VACUUM INTO copies; the image is the dump units' own
    # (Pangolin's, which ships the better-sqlite3 that dump.cjs check needs).
    DUMPS=$VOLS/systemd-sqlite-dumps/_data
    DBS=(
      "pangolin|sqlite|$QDIR/sqlite-dump/sqlite-dump-pangolin.container|-|-"
      "beszel|sqlite|$QDIR/sqlite-dump/sqlite-dump-beszel.container|-|$QDIR/beszel-hub/beszel-hub.container"
    )
    default_apps="systemd-pangolin-config systemd-letsencrypt" ;;
  *) echo "error: no restore-test config for host ${RHOST:-?}" >&2; exit 1 ;;
esac
if [[ -n ${DB_NAMES:-} ]]; then
  keep=()
  for entry in "${DBS[@]}"; do [[ " $DB_NAMES " == *" ${entry%%|*} "* ]] && keep+=("$entry"); done
  DBS=("${keep[@]}")
fi
read -r -a APP_VOLUMES <<<"${APP_VOLUMES:-$default_apps}"

# --- 1. one snapshot ---------------------------------------------------------
# --path keeps only snapshots that include the volumes path; --group-by host
# makes --latest 1 return exactly one (the newest), whatever else each
# snapshot's path set holds (#200).
if [[ -n $SNAPSHOT ]]; then
  json=$(restic snapshots --no-lock --json "$SNAPSHOT" 2>"$work/snapshots.err") && lrc=0 || lrc=$?
else
  json=$(restic snapshots --no-lock --json --host "$RHOST" --path "$VOLS" --group-by host --latest 1 2>"$work/snapshots.err") && lrc=0 || lrc=$?
fi
if (( lrc != 0 )) && ! grep -q 'no matching ID found' "$work/snapshots.err"; then
  echo "error: snapshot lookup failed: $(grep -m1 . "$work/snapshots.err")" >&2; exit 1
fi
n=$(grep -o '"id":"[0-9a-f]*"' <<<"$json" | wc -l)
(( n <= 1 )) || { echo "error: expected one snapshot, got $n" >&2; exit 1; }
id=$(grep -o '"id":"[0-9a-f]*"' <<<"$json" | head -1 | cut -d'"' -f4) || true
stime=$(grep -o '"time":"[^"]*"' <<<"$json" | head -1 | cut -d'"' -f4) || true
[[ -n $id && -n $stime ]] || { echo "error: no snapshot ${SNAPSHOT:-for host $RHOST} in the repository" >&2; exit 1; }
step "snapshot ${id:0:8} from $stime (host $RHOST)"

# --- 2. freshness of each dump -------------------------------------------------
now=$(date +%s)
for entry in "${DBS[@]}"; do
  IFS='|' read -r name kind _ _ _ <<<"$entry"
  # The data file, the counts the checks use, and the set restic must hold.
  if [[ $kind == sqlite ]]; then data=sqlite cfile=counts files=(sqlite counts "done")
  else data=sql cfile=counts.pre files=(sql counts.pre counts.post "done"); fi
  for f in "${files[@]}"; do
    if ! restic dump --no-lock "$id" "$DUMPS/$name.$f" > "$work/$name.$f" 2>"$work/$name.$f.err"; then
      # Only restic's not-found message means the file is absent; anything
      # else (repository, auth, pack errors) is reported as a dump failure.
      if grep -q 'not found in snapshot' "$work/$name.$f.err"; then flunk "$name.$f missing from snapshot"
      else flunk "$name.$f: restic dump failed: $(grep -m1 . "$work/$name.$f.err")"; fi
      rm -f "$work/$name.$data"; continue 2
    fi
  done
  # sqlite-dump's .done names the sha256 of the copy and counts it belongs
  # to: restic can read them mid-replacement (a run near 00:00), so an old
  # copy can sit beside a new .done (#195).
  if [[ $kind == sqlite ]]; then
    if ! res=$(cd "$work" && tail -n +2 "$name.done" | sha256sum -c 2>&1); then
      bad=$(grep -m1 -oE '^[^:]+: FAILED' <<<"$res" | cut -d: -f1) || true
      flunk "$name: hash mismatch: ${bad:-$name.done has no valid hash lines}"
      rm -f "$work/$name.$data"; continue
    fi
  fi
  # A dump of an emptied or renamed database still succeeds (#200).
  if [[ ! -s $work/$name.$cfile ]]; then
    flunk "$name: dump has 0 tables"; rm -f "$work/$name.$data"
  elif (( $(awk -F '\t' '{s += $2} END {print s + 0}' "$work/$name.$cfile") == 0 )); then
    flunk "$name: dump has 0 rows"; rm -f "$work/$name.$data"
  fi
  done_at=$(head -1 "$work/$name.done" | head -c 40)
  # date -d accepts "" and many other strings, so check dump.bash's exact format.
  if [[ ! $done_at =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
    flunk "$name.done is not a timestamp: '$done_at'"; continue
  fi
  age_h=$(( (now - $(date -d "$done_at" +%s)) / 3600 ))
  if (( age_h <= MAX_AGE_H )); then pass "$name dump finished $done_at (${age_h} h ago)"
  else flunk "$name dump is stale: finished $done_at (${age_h} h ago, max ${MAX_AGE_H} h)"; fi
done

# --- 3a. check each SQLite copy (#195) ---------------------------------------------
for entry in "${DBS[@]}"; do
  IFS='|' read -r name kind quadlet _ hubq <<<"$entry"
  [[ $kind == sqlite && -s $work/$name.sqlite ]] || continue
  img=$(image_of "$quadlet")
  step "$name: checking the restored copy ($img)"
  if out=$(podman run --rm --network none -e NODE_PATH=/app/node_modules -v "$work:/work:z" \
      -v "$DUMP_SCRIPT:/dump.cjs:ro,z" --entrypoint node "$img" /dump.cjs check "/work/$name.sqlite" "/work/$name.counts" 2>&1); then
    pass "$name: $out, integrity_check ok, counts equal the dump's"
  else
    flunk "$name: copy failed check: $(tail -1 <<<"$out")"; continue
  fi
  [[ $hubq != - ]] || continue
  # Recovery, not only integrity: a throwaway hub must start on the copy.
  hub=$(image_of "$hubq"); app=$work/$name-app ctr=$net-$name
  mkdir -p "$app" && cp "$work/$name.sqlite" "$app/data.db"
  if ! podman run -d --name "$ctr" --network none -v "$app:/beszel_data:Z" "$hub" >/dev/null 2>"$work/$name.app.err"; then
    flunk "$name: throwaway hub did not start: $(grep -m1 . "$work/$name.app.err")"; continue
  fi
  healthy=0
  for _ in $(seq 60); do
    podman exec "$ctr" /beszel health --url http://localhost:8090 >/dev/null 2>&1 && { healthy=1; break; }
    sleep 1
  done
  podman rm -f -v "$ctr" >/dev/null 2>&1 || true
  if (( healthy )); then pass "$name: a throwaway hub on the restored copy answers /api/health"
  else flunk "$name: a throwaway hub on the restored copy never answered /api/health"; fi
done

# --- 3. load each dump into a throwaway server ----------------------------------
podman network create "$net" >/dev/null
pw=$(head -c 18 /dev/urandom | base64 | tr -d '/+=')
sql_counts() {  # kind ctr user db -> sorted "<schema>.<table>\t<count>"
  local kind=$1 ctr=$2 user=$3 db=$4
  case $kind in
    mariadb)
      podman exec -e MYSQL_PWD="$pw" "$ctr" sh -c "mariadb -uroot -N -e \"SELECT CONCAT('SELECT ''', table_schema, '.', table_name, ''', COUNT(*) FROM \\\`', table_schema, '\\\`.\\\`', table_name, '\\\`;') FROM information_schema.tables WHERE table_type = 'BASE TABLE' AND table_schema = '$db'\" | mariadb -uroot -N" ;;
    postgres)
      podman exec "$ctr" sh -c "psql -U $user -d $db -Atc \"SELECT format('SELECT %L || chr(9) || count(*) FROM %I.%I;', schemaname || '.' || relname, schemaname, relname) FROM pg_stat_user_tables\" | psql -U $user -d $db -At" ;;
  esac | LC_ALL=C sort
}
for entry in "${DBS[@]}"; do
  IFS='|' read -r name kind quadlet user _ <<<"$entry"
  [[ $kind != sqlite && -s $work/$name.sql ]] || continue
  ctr=$net-$name img=$(image_of "$quadlet")
  step "$name: loading the dump into a throwaway server ($img)"
  case $kind in
    mariadb)
      podman run -d --name "$ctr" --network "$net" -e MARIADB_ROOT_PASSWORD="$pw" \
        -e MARIADB_DATABASE="$name" -e MARIADB_USER="$user" -e MARIADB_PASSWORD="$pw" "$img" >/dev/null
      ready() { podman exec -e MYSQL_PWD="$pw" "$ctr" mariadb -h 127.0.0.1 -uroot -e 'SELECT 1' >/dev/null 2>&1; }
      load() { podman exec -i -e MYSQL_PWD="$pw" "$ctr" mariadb -uroot < "$work/$name.sql"; } ;;
    postgres)
      podman run -d --name "$ctr" --network "$net" -e PGDATA=/var/lib/postgresql/data \
        -e POSTGRES_DB="$name" -e POSTGRES_USER="$user" -e POSTGRES_PASSWORD="$pw" "$img" >/dev/null
      ready() { podman exec "$ctr" pg_isready -h 127.0.0.1 -U "$user" -d "$name" >/dev/null 2>&1; }
      load() { podman exec -i "$ctr" psql -q -v ON_ERROR_STOP=1 -U "$user" -d "$name" < "$work/$name.sql" >/dev/null; } ;;
  esac
  for _ in $(seq 120); do ready && break; sleep 1; done
  ready || { flunk "$name: throwaway server never became ready"; continue; }
  if ! load; then flunk "$name: dump failed to load (first SQL error above)"; continue; fi
  sql_counts "$kind" "$ctr" "$user" "$name" > "$work/$name.counts.restored"
  if awk -F '\t' -v name="$name" '
      FILENAME == ARGV[1] { pre[$1] = $2; next }
      FILENAME == ARGV[2] { post[$1] = $2; next }
      { got[$1] = $2 }
      END {
        bad = 0
        for (t in pre) if (!(t in got)) { printf "    FAIL  %s: table %s missing after restore\n", name, t; bad = 1 }
        for (t in got) {
          if (!(t in pre)) { printf "    FAIL  %s: unexpected table %s\n", name, t; bad = 1; continue }
          if (got[t] + 0 < pre[t] + 0 || got[t] + 0 > post[t] + 0) {
            printf "    FAIL  %s: %s has %d rows, expected %d..%d\n", name, t, got[t], pre[t], post[t]; bad = 1 }
        }
        exit bad
      }' "$work/$name.counts.pre" "$work/$name.counts.post" "$work/$name.counts.restored"; then
    pass "$name: $(wc -l < "$work/$name.counts.restored") tables, every row count within [pre, post]"
  else
    FAILED=1
  fi
done

# --- 4. app volumes -------------------------------------------------------------
for vol in "${APP_VOLUMES[@]}"; do
  live=$VOLS/$vol/_data
  [[ -d $live ]] || { flunk "$vol: not present on this host"; continue; }
  step "$vol: restoring from ${id:0:8}"
  restic restore --no-lock "$id" --include "$live" --target /work/restore >/dev/null
  rest=$work/restore$live
  [[ -d $rest ]] || { flunk "$vol: not in the snapshot"; continue; }
  # Only files untouched since the snapshot can be compared byte for byte.
  if ! (cd "$live" && find . -type f ! -newermt "@$(date -d "$stime" +%s)" -print0) > "$work/$vol.list"; then
    flunk "$vol: could not list the live copy"; rm -rf "$work/restore"; continue
  fi
  # One file at a time: a file deleted since find is no longer "unchanged" and
  # drops out; any other hashing failure is a failure, not a smaller sample.
  : > "$work/$vol.live"; hashfail=0
  while IFS= read -r -d '' f; do
    if h=$(cd "$live" && sha256sum -- "$f" 2>/dev/null); then printf '%s\n' "$h" >> "$work/$vol.live"
    elif [[ -e $live/$f ]]; then flunk "$vol: cannot hash live file $f"; hashfail=1; fi
  done < <(sort -z "$work/$vol.list")
  if (( hashfail )); then rm -rf "$work/restore"; continue; fi
  n=$(wc -l < "$work/$vol.live")
  if (( n == 0 )); then
    pass "$vol: restored; no files older than the snapshot to compare"
  elif (cd "$rest" && sha256sum --quiet -c "$work/$vol.live") > "$work/$vol.diff" 2>&1; then
    pass "$vol: $n unchanged files identical to the live copy"
  else
    flunk "$vol: $(grep -c FAILED "$work/$vol.diff" || true) of $n files differ or are missing"
    head -5 "$work/$vol.diff" | sed 's/^/          /'
  fi
  rm -rf "$work/restore"
done

if (( FAILED )); then echo "restore test: FAILED"; exit 1; fi
echo "restore test: passed (snapshot ${id:0:8})"
PAYLOAD_EOF

_script="SNAPSHOT=$(printf %q "$_snapshot")"$'\n'"$_payload"
echo "==> $_target (ssh may wait for a security-key touch)"
# shellcheck disable=SC2029 # expanded locally on purpose
ssh "$_target" "sudo bash -c $(printf %q "$_script")"
